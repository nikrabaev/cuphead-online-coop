<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time check that every game member the mod hooks or looks up by name still exists. Runs after each
       build of CupheadOnline.csproj (skip with -p:CheckHooks=false). Reads assemblies only; loads nothing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
